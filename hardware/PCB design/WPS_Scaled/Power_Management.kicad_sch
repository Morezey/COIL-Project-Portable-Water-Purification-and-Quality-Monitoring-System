	(text "J1 is the 12V battery connector\nD1 prevents damage if battery is connected backwards\nR21 is a high-side shunt used to increase the range of the INA219 sensor\nC1 is a bulk capacitor that provides energy storage for high-current loads"
		(exclude_from_sim no)
		(at 29.464 70.358 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "971d9b20-f556-412b-bac1-9816366e8619")
	)
