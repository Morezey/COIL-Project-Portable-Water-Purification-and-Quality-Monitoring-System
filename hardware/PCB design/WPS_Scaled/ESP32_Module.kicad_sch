	(text "Review:\nIt is recommended to connect a 499 Ω series resistor to the U0TXD\nline to suppress harmonics.(TX line)\n\nMake power taces as thick as possible:\nMain 3.3V line   ≥ 25 mil\nRF power pins (pin2 & pin3) ≥ 20 mil\nOther small power branches  ≥ 10 mil\n"
		(exclude_from_sim no)
		(at 210.312 88.646 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "5da19df4-360a-41f3-a711-a0d15b114d8b")
	)
	(text "Caution: Limit total USB current draw to <500mA. \nExcessive peripheral (sensor) load may trigger host port \novercurrent protection, requiring a system restart \nto reset the port."
		(exclude_from_sim no)
		(at 113.03 192.532 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "9e09d01d-7330-4c17-8e11-6030873ed312")
	)
	(text "D4 - Led used to show 3.3V is supplied\nD12- Led used to show 5V is supplied\nD13 - Led used to show 5V_SW (required by sensors) is supplied\nD14 - Led used to show 12V is supplied"
